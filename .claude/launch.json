{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import os,http.server,socketserver;socketserver.TCPServer.allow_reuse_address=True;socketserver.TCPServer(('',int(os.environ.get('PORT','8765'))),http.server.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "autoPort": true,
      "port": 8765
    }
  ]
}
